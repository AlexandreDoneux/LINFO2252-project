<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<featureModel>
	<properties>
		<graphics key="autolayoutconstraints" value="false"/>
		<graphics key="legendautolayout" value="true"/>
		<graphics key="showconstraints" value="true"/>
		<graphics key="showshortnames" value="false"/>
		<graphics key="layout" value="horizontal"/>
		<graphics key="showcollapsedconstraints" value="true"/>
		<graphics key="legendhidden" value="false"/>
		<graphics key="layoutalgorithm" value="1"/>
	</properties>
	<struct>
		<and abstract="true" mandatory="true" name="Learning platform">
			<graphics key="collapsed" value="false"/>
			<and mandatory="true" name="feedback on task by user">
				<graphics key="collapsed" value="false"/>
				<feature mandatory="true" name="star system"/>
				<feature name="precise feedback"/>
			</and>
			<and mandatory="true" name="problem">
				<graphics key="collapsed" value="false"/>
				<and mandatory="true" name="parameters">
					<or mandatory="true" name="type">
						<feature name="code problem"/>
						<feature name="MCQ"/>
						<feature name="open question"/>
						<feature name="exact value"/>
						<feature name="connect the dots"/>
					</or>
					<and mandatory="true" name="topic">
						<feature mandatory="true" name="language course"/>
						<feature mandatory="true" name="innovation course"/>
						<feature mandatory="true" name="clean code course"/>
					</and>
					<feature name="tag"/>
					<alt name="answer limit">
						<feature name="fixed number"/>
						<feature name="number per hour"/>
						<feature name="number per day"/>
					</alt>
				</and>
				<and mandatory="true" name="difficulty">
					<feature mandatory="true" name="teacher rating"/>
					<feature name="score based"/>
					<feature name="perceived by students"/>
				</and>
				<and mandatory="true" name="automatic grading">
					<feature mandatory="true" name="grade"/>
					<or name="feedback">
						<feature name="generic"/>
						<feature name="AI feedback"/>
					</or>
				</and>
				<feature name="badge"/>
			</and>
			<and name="problem help">
				<description>accessible after a couple of tries</description>
				<feature mandatory="true" name="predefined hint"/>
				<feature name="AI hint">
					<description>limited by premium</description>
				</feature>
			</and>
			<and mandatory="true" name="problem set">
				<graphics key="collapsed" value="false"/>
				<or mandatory="true" name="search">
					<feature name="topic search"/>
					<feature name="tag search"/>
				</or>
				<or mandatory="true" name="recommendations">
					<feature name="based on topic"/>
					<feature name="based on tags"/>
					<feature name="based on problem type"/>
					<feature name="based on user feedbacks"/>
					<feature name="based on user difficulties"/>
				</or>
				<feature mandatory="true" name="topics"/>
				<feature name="tags"/>
			</and>
			<or mandatory="true" name="user authentication">
			<feature name="username/password"/>
			<or name="bindings">
				<feature name="github"/>
				<feature name="google"/>
				<feature name="facebook"/>
				<feature name="twitter"/>
			</or>
		</or>
		<and name="gamification">
			<graphics key="collapsed" value="false"/>
			<feature name="scoreboard"/>
			<feature name="daily challenges"/>
		</and>
		<and mandatory="true" name="user account">
			<graphics key="collapsed" value="false"/>
			<and mandatory="true" name="user grades">
				<feature name="badges"/>
				<and mandatory="true" name="grades">
					<feature mandatory="true" name="per task"/>
					<feature name="per tag"/>
					<feature name="per topic"/>
				</and>
			</and>
			<and mandatory="true" name="user parameters">
				<feature mandatory="true" name="region"/>
				<feature mandatory="true" name="dark/light mode"/>
				<and name="problem preferences">
					<feature name="topic preferences"/>
					<feature name="tag preferences"/>
					<feature name="problem type preferences"/>
				</and>
			</and>
			<and name="credits">
				<and mandatory="true" name="credit sources">
					<feature mandatory="true" name="ads"/>
					<feature mandatory="true" name="purchase"/>
					<feature name="challenge rewards"/>
				</and>
				<and mandatory="true" name="credit uses">
					<feature mandatory="true" name="extra problems"/>
					<feature name="premium unlock"/>
					<feature mandatory="true" name="extra hints"/>
					<feature mandatory="true" name="extra tries"/>
				</and>
			</and>
			<alt name="premium">
				<feature name="basic premium"/>
				<feature name="advanced premium"/>
				<feature name="full access"/>
			</alt>
		</and>
	</and>
</struct>
<constraints>
	<rule>
		<imp>
			<var>premium unlock</var>
			<var>basic premium</var>
		</imp>
	</rule>
	<rule>
		<imp>
			<var>tags</var>
			<var>tag</var>
		</imp>
	</rule>
	<rule>
		<imp>
			<var>based on tags</var>
			<var>tag preferences</var>
		</imp>
	</rule>
	<rule>
		<imp>
			<disj>
				<var>tag preferences</var>
				<disj>
					<var>tag search</var>
					<var>per tag</var>
				</disj>
			</disj>
			<var>tags</var>
		</imp>
	</rule>
	<rule>
		<imp>
			<var>based on topic</var>
			<var>topic preferences</var>
		</imp>
	</rule>
	<rule>
		<imp>
			<var>challenge rewards</var>
			<var>daily challenges</var>
		</imp>
	</rule>
	<rule>
		<imp>
			<var>AI hint</var>
			<disj>
				<var>premium</var>
				<var>credits</var>
			</disj>
		</imp>
	</rule>
	<rule>
		<imp>
			<var>AI feedback</var>
			<disj>
				<var>premium</var>
				<var>credits</var>
			</disj>
		</imp>
	</rule>
	<rule>
		<imp>
			<var>extra hints</var>
			<var>problem help</var>
		</imp>
	</rule>
	<rule>
		<imp>
			<var>extra tries</var>
			<var>answer limit</var>
		</imp>
	</rule>
</constraints>
</featureModel>
